{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/journeys/:slug", "destination": "/journeys/detail.html?slug=:slug" },
    { "source": "/destinations/:slug", "destination": "/destinations/detail.html?slug=:slug" },
    { "source": "/experiences/:slug", "destination": "/experiences/detail.html?slug=:slug" },
    { "source": "/stays/:slug", "destination": "/stays/detail.html?slug=:slug" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; script-src 'self' 'unsafe-inline'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        }
      ]
    }
  ]
}